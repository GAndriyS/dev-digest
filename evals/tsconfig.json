{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    // The CI change detector is plain dependency-free .mjs (its CI job runs it without an
    // install), and src/ci-detect.test.ts imports it — so the JS has to be resolvable here.
    // allowJs only; checkJs stays off, so the .mjs is type-inferred, not type-checked.
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src", "skills", "agents", "workflow", "vitest.config.ts"],
  "exclude": ["node_modules", "**/fixtures/**"]
}
