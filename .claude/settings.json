{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/pr-gate-check.mjs",
            "if": "Bash(gh pr create*)",
            "timeout": 15,
            "statusMessage": "Checking PR self-review gate…"
          }
        ]
      }
    ]
  }
}
