node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# /pr-self-review output: the run report and the drafted PR body. Regenerated
# per branch on every run; the verdict stamp itself lives in .git/.
.claude/reviews/

# skill-evals: per-run outputs are ephemeral and regenerated by the harness.
# The recorded evidence a CI gate compares against lives in
# skill-evals/baselines/ and IS committed.
skill-evals/results/

# The repo root is not a workspace and must install nothing. A lockfile here
# means someone ran `pnpm install` at the root by accident — never commit it.
# (Package lockfiles live at server/, client/, evals/, … and ARE tracked.)
/pnpm-lock.yaml
